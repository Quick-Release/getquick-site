+# Runs each deploy extension ($EXTENSIONS_PATH/*.sh, site-owned) with bash
+# from $APP_PATH, in lexical (byte) order, with SITE_PATH and APP_PATH set:
+# after activation and the database update, before the rewrite flush.
+# The first one that exits non-zero fails the deploy with its exit code. No
+# directory, or no extension in it, is fine.
+run_deploy_extensions() {
+  local extension extension_status
+  [ -d "$SITE_PATH/$EXTENSIONS_PATH" ] || return 0
+  find "$SITE_PATH/$EXTENSIONS_PATH" -mindepth 1 -maxdepth 1 -type f -name '*.sh' \
+    | LC_ALL=C sort >"$tmp_dir/extensions"
+  while IFS= read -r extension; do
+    echo "Running deploy extension ${extension#"$SITE_PATH/"}"
+    extension_status=0
+    SITE_PATH="$SITE_PATH" APP_PATH="$APP_PATH" bash "$extension" </dev/null || extension_status=$?
+    if [ "$extension_status" -ne 0 ]; then
+      echo "Deploy extension ${extension#"$SITE_PATH/"} failed (exit $extension_status)." >&2
+      exit "$extension_status"
+    fi
+  done <"$tmp_dir/extensions"
+}
