---
import Layout from "../layouts/Layout.astro";
import { formatDate, getEntryByUri, responseStatus } from "../lib/wordpress";
import { blockPresetStyles } from "../lib/wp-block-styles";

const uri = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const delivery = await getEntryByUri(uri);
// Only a confirmed missing entry is a 404; a CMS failure is a 503.
Astro.response.status = responseStatus(delivery);
const entry = delivery.kind === "found" ? delivery.content : null;
const { vars, colorRules } = blockPresetStyles(entry?.spacingSizes ?? [], entry?.colors ?? []);
const isPost = Boolean(entry?.date);
const title =
  entry?.title || (delivery.kind === "unavailable" ? "Temporarily unavailable" : "Page not found");
---

<Layout title={title}>
  {entry ? (
    entry.hasVideoHero ? (
      <>
        <style is:global set:html={colorRules} />
        <main class="prose-wp prose-wp--video-hero" style={vars} set:html={entry.content}></main>
      </>
    ) : (
      <main>
        <h1>{entry.title}</h1>
        {isPost && <time datetime={entry.date}>{formatDate(entry.date)}</time>}
        {entry.featuredImage && (
          <img class="featured-image" src={entry.featuredImage.sourceUrl} alt={entry.featuredImage.altText || ""} />
        )}
        <style is:global set:html={colorRules} />
        <div class="prose-wp" style={vars} set:html={entry.content}></div>
      </main>
    )
  ) : delivery.kind === "missing" ? (
    <main class="empty-state">
      <h1>Nothing here.</h1>
      <p>This page doesn't exist in WordPress yet.</p>
      <a href="/">Back to the front page</a>
    </main>
  ) : (
    <main class="empty-state">
      <h1>Temporarily unavailable.</h1>
      <p>This page can't be loaded right now. Please try again in a few minutes.</p>
      <a href="/">Back to the front page</a>
    </main>
  )}
</Layout>
