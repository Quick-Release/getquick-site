---
import Layout from "../layouts/Layout.astro";
import { publishedEntry } from "../lib/delivery";
import { formatDate, responseStatus } from "../lib/wordpress";
import { blockPresetStyles } from "../lib/wp-block-styles";

// Served from the publication store, last-known-good and without an age
// limit. Only an entry the store has never held is looked up in the CMS.
const delivery = await publishedEntry(Astro.url.pathname, Astro.site?.origin);
// An entry published at another URI now: its old route redirects there,
// uncached, since the store's answer can change with the next refresh.
if (delivery.kind === "moved") {
  return new Response(null, {
    status: 301,
    headers: { Location: encodeURI(delivery.uri), "Cache-Control": "no-store" },
  });
}
// Only a confirmed missing entry is a 404; a CMS or store failure is a 503.
Astro.response.status = responseStatus(delivery);
const entry = delivery.kind === "found" ? delivery.content.entry : null;
const chrome =
  delivery.kind === "found" ? delivery.content.chrome : delivery.kind === "missing" ? delivery.chrome : null;
const { vars, colorRules } = blockPresetStyles(entry?.spacingSizes ?? [], entry?.colors ?? []);
const isPost = Boolean(entry?.date);
const title =
  entry?.title || (delivery.kind === "unavailable" ? "Temporarily unavailable" : "Page not found");
---

<Layout title={title} chrome={chrome}>
  {entry ? (
    entry.hasVideoHero ? (
      <>
        <style is:global set:html={colorRules} />
        <main class="prose-wp prose-wp--video-hero" style={vars} set:html={entry.content}></main>
      </>
    ) : (
      <main>
        <h1>{entry.title}</h1>
        {isPost && <time datetime={entry.date}>{formatDate(entry.date)}</time>}
        {entry.featuredImage && (
          <img class="featured-image" src={entry.featuredImage.sourceUrl} alt={entry.featuredImage.altText || ""} />
        )}
        <style is:global set:html={colorRules} />
        <div class="prose-wp" style={vars} set:html={entry.content}></div>
      </main>
    )
  ) : delivery.kind === "missing" ? (
    <main class="empty-state">
      <h1>Nothing here.</h1>
      <p>This page doesn't exist in WordPress yet.</p>
      <a href="/">Back to the front page</a>
    </main>
  ) : (
    <main class="empty-state">
      <h1>Temporarily unavailable.</h1>
      <p>This page can't be loaded right now. Please try again in a few minutes.</p>
      <a href="/">Back to the front page</a>
    </main>
  )}
</Layout>
