---
import Layout from "../layouts/Layout.astro";
import { getHomeContent } from "../lib/wordpress";
import { blockPresetStyles } from "../lib/wp-block-styles";

const { connected, settings, page, spacingSizes, colors } = await getHomeContent();
const { vars, colorRules } = blockPresetStyles(spacingSizes, colors);
const siteTitle = page?.title || settings?.title || "{{Project}}";
const isVideoHeroPage = page?.hasVideoHero ?? false;
---

<Layout title={siteTitle} description={settings?.description}>
  {page?.content ? (
    <>
      <style is:global set:html={colorRules} />
      <main class={isVideoHeroPage ? "prose-wp prose-wp--video-hero" : "prose-wp"} style={vars} set:html={page.content}></main>
    </>
  ) : (
    <main class="empty-state">
      <h1>{connected ? "The front page is almost ready." : "Content is on its way."}</h1>
      <p>
        {connected
          ? "Set a page as the front page in WordPress (Settings → Reading) and publish its blocks to show them here."
          : "The front page appears here once the CMS is reachable."}
      </p>
    </main>
  )}
</Layout>
