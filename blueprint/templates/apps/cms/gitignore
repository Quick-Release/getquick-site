# Machine-local plugin overrides and preserved registry installs
/.ddev/docker-compose.*.local.yaml
/.ddev/config.*.local.yaml
/.local-plugins/

# Application
# Composer installs every plugin; a plugin of this site's own (not in the
# GETQUICK Composer registry) lives here, unignored like:
#   !web/app/plugins/{{project}}-blocks/
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
# Composer installs every theme, getquick-theme among them; a child theme of
# this site's own lives here, unignored like:
#   !web/app/themes/{{project}}-theme/
web/app/themes/*
!web/app/themes/.gitkeep
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example
!.env.production.example
.env.keys
.env.*.keys

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml
